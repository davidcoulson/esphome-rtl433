+// Throw away what the driver has buffered: a hot retune or rate change does not clear its pull ring, so
+// whatever is in it was captured with the old settings
+static void esp_sdr_discard_buffered(sdr_dev_t *dev, uint8_t *scratch, size_t len)
+{
+    size_t got;
+    int rounds = 0;
+    do {
+        got = 0;
+        if (esp_rtl_sdr_read(dev->esp_dev, scratch, len, 0, &got) != ESP_OK)
+            break; // empty (timeout) or not streaming
+    } while (got == len && ++rounds < 64); // a full read: there may be more
+}
+
+static int esp_sdr_read_loop(sdr_dev_t *dev, sdr_event_cb_t cb, void *ctx, uint32_t buf_num, uint32_t buf_len)
+{
+    size_t buffer_size = (size_t)buf_num * buf_len;
+    if (dev->buffer_size != buffer_size) {
+        free(dev->buffer);
+        dev->buffer = malloc(buffer_size);
+        if (!dev->buffer) {
+            WARN_MALLOC("esp_sdr_read_loop()");
+            return -1;
+        }
+        dev->buffer_size = buffer_size;
+        dev->buffer_pos = 0;
+    }
+
+    if (!dev->esp_streaming && esp_sdr_start_stream(dev) < 0)
+        return -1;
+
+    // Every block is labelled with the settings it was captured with. A retune or rate change (main task)
+    // bumps esp_tune_gen once it has taken effect; samples captured before it can still be in the driver's
+    // ring, and a hop retunes while the previous block is being decoded, so the next block starts by
+    // dropping them, and a block that a change landed in the middle of is dropped whole. That costs about
+    // one block per hop, which used to be decoded at the new band's rate with its decoders anyway.
+    uint32_t seen_disconnects = esp_disconnects; // one after this: NOT_STREAMING means unplugged, give up
+    uint32_t seen_gen;
+#ifdef THREADS
+    pthread_mutex_lock(&dev->lock);
+#endif
+    seen_gen = dev->esp_tune_gen;
+#ifdef THREADS
+    pthread_mutex_unlock(&dev->lock);
+#endif
+
+    dev->running = 1;
+    do {
+        if (dev->buffer_pos + buf_len > buffer_size)
+            dev->buffer_pos = 0;
+        uint8_t *buffer = &dev->buffer[dev->buffer_pos];
+        dev->buffer_pos += buf_len;
+
+        uint32_t gen;
+#ifdef THREADS
+        pthread_mutex_lock(&dev->lock);
+#endif
+        gen = dev->esp_tune_gen;
+#ifdef THREADS
+        pthread_mutex_unlock(&dev->lock);
+#endif
+        if (gen != seen_gen) {
+            esp_sdr_discard_buffered(dev, buffer, buf_len);
+            seen_gen = gen;
+        }
+
+        size_t n_read = 0;
+        int exit_acquire = 0;
+        while (n_read < buf_len) {
+#ifdef THREADS
+            pthread_mutex_lock(&dev->lock);
+            exit_acquire = dev->exit_acquire;
+            pthread_mutex_unlock(&dev->lock);
+#endif
+            if (exit_acquire || !dev->running)
+                break;
+            size_t got = 0;
+            esp_err_t err = esp_rtl_sdr_read(dev->esp_dev, &buffer[n_read], buf_len - n_read,
+                    ESP_SDR_READ_TIMEOUT_MS, &got);
+            if (err == ESP_OK) {
+                n_read += got;
+            }
+            else if (err == ESP_RTL_SDR_ERR_NOT_STREAMING && dev->esp_streaming && esp_disconnects == seen_disconnects) {
+                vTaskDelay(pdMS_TO_TICKS(10)); // a rate change is restarting the stream
+            }
+            else if (err != ESP_RTL_SDR_ERR_TIMEOUT && err != ESP_ERR_TIMEOUT) {
+                // Unplugged or faulted. Stop delivering; rtl_433's stall watchdog restarts the input.
+                print_logf(LOG_WARNING, "SDR", "USB read failed: %s", esp_rtl_sdr_err_to_name(err));
+                dev->esp_streaming = 0; // (the disconnect callback used to clear this, racing sdr_close)
+                dev->running = 0;
+                break;
+            }
+            // on timeout just go round: no samples yet, check exit_acquire again
+        }
+        if (exit_acquire)
+            break;
+
+#ifdef THREADS
+        pthread_mutex_lock(&dev->lock);
+#endif
+        uint32_t sample_rate      = dev->sample_rate;
+        uint32_t center_frequency = dev->center_frequency;
+        gen                       = dev->esp_tune_gen;
+#ifdef THREADS
+        pthread_mutex_unlock(&dev->lock);
+#endif
+        if (gen != seen_gen)
+            continue; // the settings changed while this block filled: part of it is the old band
+        sdr_event_t ev = {
+                .ev               = SDR_EV_DATA,
+                .sample_rate      = sample_rate,
+                .center_frequency = center_frequency,
+                .buf              = buffer,
+                .len              = n_read,
+        };
+        if (n_read > 0)
+            cb(&ev, ctx);
+        // our own stack high-water mark, for the health sensor (see rtl433_port.h)
+        {
+            static TickType_t last_hwm = 0;
+            TickType_t now_ticks = xTaskGetTickCount();
+            if (now_ticks - last_hwm > pdMS_TO_TICKS(1000)) {
+                last_hwm = now_ticks;
+                rtl433_port_acquire_stack_free = (unsigned)uxTaskGetStackHighWaterMark(NULL);
+            }
+        }
+    } while (dev->running);
+
+    return 0;
+}
+
+void sdr_abort(sdr_dev_t *dev)
+{
+    if (!dev)
+        return;
+#ifdef THREADS
+    pthread_mutex_lock(&dev->lock);
+    dev->exit_acquire = 1;
+#endif
+    dev->running = 0;
+#ifdef THREADS
+    pthread_mutex_unlock(&dev->lock);
+#endif
+    if (dev->esp_dev) {
+        pthread_mutex_lock(&esp_active_lock);
+        if (esp_active == dev->esp_dev)
+            esp_active = NULL;
+        pthread_mutex_unlock(&esp_active_lock);
+        esp_rtl_sdr_stop(dev->esp_dev, 0); // a pending read returns NOT_STREAMING and the reader ends
+        dev->esp_streaming = 0;
+    }
+}
