+/* esp_rtl_sdr (ESP32-P4 USB host) */
+
+#ifdef ESP_RTL_SDR
+
+#define ESP_SDR_DEFAULT_FREQ 433920000u
+#define ESP_SDR_DEFAULT_RATE 250000u
+#define ESP_SDR_ATTACH_WAIT_MS 15000
+#define ESP_SDR_READ_TIMEOUT_MS 500
+#define ESP_SDR_NOT_STREAMING_MAX_MS 5000 // longer than the stop/start a rate change does
+#define ESP_SDR_START_BACKOFF_MAX_MS 30000
+
+// The open handle, for the ESPHome component's diagnostics; guarded against a concurrent close
+static pthread_mutex_t esp_active_lock = PTHREAD_MUTEX_INITIALIZER;
+static esp_rtl_sdr_handle_t esp_active = NULL;
+// The driver (and the USB host library under it) is installed once and kept: uninstalling with a device
+// attached fails in the host library, and a re-install after that fails too. A restart or replug only
+// stops and starts the stream; the driver's own rescan handles the dongle coming back.
+static esp_rtl_sdr_handle_t esp_handle = NULL;
+
+int rtl433_port_usb_stats(struct rtl433_usb_stats *out)
+{
+    int ok = 0;
+    pthread_mutex_lock(&esp_active_lock);
+    if (esp_active) {
+        esp_rtl_sdr_metrics_t m;
+        if (esp_rtl_sdr_get_metrics(esp_active, &m) == ESP_OK) {
+            out->effective_sps  = m.effective_sps;
+            out->sample_rate    = m.sample_rate_sps;
+            out->frequency      = m.frequency_hz;
+            out->overruns       = m.overruns;
+            out->consumer_drops = m.consumer_drops;
+            out->bytes_total    = m.bytes_total;
+            ok = 1;
+        }
+    }
+    pthread_mutex_unlock(&esp_active_lock);
+    return ok;
+}
+
+// Counts the driver's disconnect events. The callback runs on the driver's USB task, which must not touch an
+// sdr_dev_t: the main task can close (free) it at any moment. The read loop compares this instead.
+static volatile uint32_t esp_disconnects = 0;
+// Counts the driver's EVT_ERROR events, for the same reason. The driver sends one when the stream dies
+// (FAULT), when an unplugged dongle cannot be closed yet, or when a retune failed and it kept the previous
+// frequency (the samples are then not where rtl_433 decodes). The read loop restarts the input on a change.
+static volatile uint32_t esp_errors = 0;
+
+static void esp_sdr_event_cb(esp_rtl_sdr_event_t event, const void *payload, void *ctx)
+{
+    UNUSED(ctx);
+    switch (event) {
+    case ESP_RTL_SDR_EVT_ENUMERATED: {
+        esp_rtl_sdr_device_info_t const *info = payload;
+        if (info)
+            print_logf(LOG_NOTICE, "SDR", "USB SDR attached: %s %s, SN: %s (%s speed)",
+                    info->manufacturer, info->product, info->serial, info->high_speed ? "high" : "full");
+        break;
+    }
+    case ESP_RTL_SDR_EVT_DISCONNECTED:
+        esp_disconnects++; // first: the log below may block
+        print_log(LOG_ERROR, "SDR", "USB SDR disconnected");
+        break;
+    case ESP_RTL_SDR_EVT_ERROR: {
+        esp_errors++; // first: the log below may block
+        esp_rtl_sdr_error_info_t const *err = payload;
+        if (err)
+            print_logf(LOG_WARNING, "SDR", "esp_rtl_sdr: %s %s", esp_rtl_sdr_err_to_name(err->code), err->message);
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+static int esp_opened_before = 0; // only the first open (start-up) waits for the dongle
+static int esp_absent_logged = 0; // "no dongle" is logged once per absence, not on every retry
+static int esp_cleanup_pending = 0; // esp_handle is the driver's cleanup-only handle from a failed install
+
+static int esp_sdr_open(sdr_dev_t **out_dev, char const *dev_query, int verbose)
+{
+    UNUSED(verbose);
+    int may_wait = !esp_opened_before;
+    esp_opened_before = 1;
+    if (esp_cleanup_pending) {
+        // A failed install that could not unwind returned this handle: it is the only way to release what the
+        // driver kept (workers, USB ownership), so finish that before installing again
+        if (esp_rtl_sdr_uninstall(esp_handle) != ESP_OK) {
+            print_log(LOG_ERROR, __func__, "esp_rtl_sdr_uninstall of a failed install did not finish; will retry");
+            return -1;
+        }
+        esp_handle = NULL;
+        esp_cleanup_pending = 0;
+    }
+    if (esp_handle == NULL) {
+        esp_rtl_sdr_config_t config;
+        esp_rtl_sdr_config_default(&config);
+        if (rtl433_port_usb_ring_bytes)
+            config.pull_ring_bytes = rtl433_port_usb_ring_bytes;
+        if (rtl433_port_usb_task_priority)
+            config.usb_task_priority = rtl433_port_usb_task_priority;
+        config.usb_task_core_id = rtl433_port_usb_task_core;
+        config.event_cb = esp_sdr_event_cb;
+        config.event_ctx = NULL; // set per open below: the dev comes and goes, the handle doesn't
+        config.delivery_mode = ESP_RTL_SDR_DELIVERY_READ; // rtl_433 pulls, like a socket
+        esp_err_t err = esp_rtl_sdr_install(&config, &esp_handle);
+        if (err == ESP_RTL_SDR_ERR_USB_SAFE_MODE) {
+            // The driver's crash guard: the USB stack panicked during enumeration on several boots in a
+            // row, so it stays off for this boot rather than boot-looping. Only a real latch reaches here.
+            print_log(LOG_ERROR, __func__, "USB host disabled for this boot after repeated USB crashes; power-cycle to retry");
+            esp_handle = NULL;
+            return -1;
+        }
+        if (err != ESP_OK) {
+            print_logf(LOG_ERROR, __func__, "esp_rtl_sdr_install failed: %s", esp_rtl_sdr_err_to_name(err));
+            esp_cleanup_pending = esp_handle != NULL; // keep a cleanup-only handle, see above
+            return -1;
+        }
+    }
+
+    // The dongle enumerates asynchronously after the host library starts, so the first open (start-up,
+    // right after the install, before the event loop runs) waits for it. Every later open is a retry from
+    // timer_handler() on the event loop, which comes back every 1.5 s: it only looks, because waiting
+    // there stalls HTTP and WebSocket for as long as the dongle is missing.
+    esp_rtl_sdr_device_info_t info = {0};
+    int waited_ms = 0;
+    while (esp_rtl_sdr_get_device_info(esp_handle, &info) != ESP_OK || !info.present) {
+        if (!may_wait || waited_ms >= ESP_SDR_ATTACH_WAIT_MS) {
+            if (!esp_absent_logged)
+                print_log(LOG_ERROR, __func__, "No supported RTL-SDR dongle on the USB host port");
+            esp_absent_logged = 1;
+            return -1;
+        }
+        vTaskDelay(pdMS_TO_TICKS(100));
+        waited_ms += 100;
+    }
+    esp_absent_logged = 0;
+
+    // Allocated only once the dongle is there: nothing to undo on the failure paths above
+    sdr_dev_t *dev = calloc(1, sizeof(sdr_dev_t));
+    if (!dev) {
+        WARN_CALLOC("esp_sdr_open()");
+        return -1;
+    }
+#ifdef THREADS
+    pthread_mutex_init(&dev->lock, NULL);
+#endif
+    dev->esp_gain = -1;
+    dev->esp_biastee = -1;
+    dev->esp_digital_agc = -1;
+    dev->esp_dev = esp_handle;
+    esp_err_t err;
+
+    // "esp:SERIAL" picks one dongle when several share a hub
+    char const *serial = arg_param(dev_query);
+    if (serial && *serial) {
+        err = esp_rtl_sdr_select_device_serial(dev->esp_dev, serial);
+        if (err != ESP_OK)
+            print_logf(LOG_WARNING, __func__, "No dongle with serial %s (%s); using the first one",
+                    serial, esp_rtl_sdr_err_to_name(err));
+        esp_rtl_sdr_get_device_info(dev->esp_dev, &info);
+    }
+
+    print_logf(LOG_CRITICAL, "SDR", "Using USB device: %s, %s, SN: %s", info.manufacturer, info.product, info.serial);
+    dev->sample_size = sizeof(uint8_t) * 2; // CU8
+    dev->sample_signed = 0;
+
+    size_t info_len = 41 + strlen(info.manufacturer) + strlen(info.product) + strlen(info.serial);
+    dev->dev_info = malloc(info_len);
+    if (!dev->dev_info) {
+        WARN_MALLOC("esp_sdr_open()"); // dev_info stays NULL: get_dev_info reports none
+    }
+    else {
+        snprintf(dev->dev_info, info_len, "{\"vendor\":\"%s\", \"product\":\"%s\", \"serial\":\"%s\"}",
+                info.manufacturer, info.product, info.serial);
+    }
+
+    pthread_mutex_lock(&esp_active_lock);
+    esp_active = dev->esp_dev;
+    pthread_mutex_unlock(&esp_active_lock);
+
+    *out_dev = dev;
+    return 0;
+}
+
+// Gain can only be written once the interface is claimed, i.e. after the stream starts
+static void esp_sdr_apply_gain(sdr_dev_t *dev)
+{
+    esp_err_t err;
+    if (dev->esp_gain < 0)
+        err = esp_rtl_sdr_set_tuner_gain_mode(dev->esp_dev, ESP_RTL_SDR_GAIN_MODE_AUTO);
+    else
+        err = esp_rtl_sdr_set_tuner_gain(dev->esp_dev, dev->esp_gain);
+    if (err != ESP_OK)
+        print_logf(LOG_WARNING, "SDR", "Setting tuner gain failed: %s", esp_rtl_sdr_err_to_name(err));
+}
+
+// Consecutive stream start failures back off (1 s, 2 s, 4 s ... 30 s) so a dongle that keeps failing is not
+// hammered with a full init sequence on every watchdog restart (the gate is in esp_sdr_read_loop; a rate
+// change's own restart and its fall-back are not throttled). Kept across sdr_open(): the dev is per open,
+// the dongle is not. Any successful start clears it.
+static unsigned esp_start_failures = 0;
+static TickType_t esp_start_not_before = 0;
+
+static int esp_sdr_start_stream(sdr_dev_t *dev)
+{
+    uint32_t freq = dev->esp_freq ? dev->esp_freq : ESP_SDR_DEFAULT_FREQ;
+    uint32_t rate = dev->esp_rate ? dev->esp_rate : ESP_SDR_DEFAULT_RATE;
+    if (dev->esp_ppm)
+        esp_rtl_sdr_set_freq_correction(dev->esp_dev, dev->esp_ppm);
+    esp_err_t err = esp_rtl_sdr_start_hz(dev->esp_dev, freq, rate);
+    if (err == ESP_RTL_SDR_ERR_FAULT) {
+        // A failed start (one USB error in the init table) or a dead stream leaves the driver in FAULT, and
+        // start() refuses until stop() or reset() clears it. stop() drains and releases what is left, then
+        // reset() clears FAULT; it refuses (ERR_BUSY) while transfers are still live, and the backoff below
+        // gives them time.
+        print_log(LOG_WARNING, "SDR", "USB SDR driver in FAULT; resetting it");
+        esp_rtl_sdr_stop(dev->esp_dev, 0);
+        esp_err_t rerr = esp_rtl_sdr_reset(dev->esp_dev);
+        if (rerr != ESP_OK && esp_rtl_sdr_get_state(dev->esp_dev) != ESP_RTL_SDR_STATE_IDLE)
+            print_logf(LOG_WARNING, "SDR", "USB SDR reset failed: %s", esp_rtl_sdr_err_to_name(rerr));
+        err = esp_rtl_sdr_start_hz(dev->esp_dev, freq, rate);
+    }
+    if (err != ESP_OK) {
+        unsigned backoff_ms = 1000u << (esp_start_failures < 5 ? esp_start_failures : 5);
+        if (backoff_ms > ESP_SDR_START_BACKOFF_MAX_MS)
+            backoff_ms = ESP_SDR_START_BACKOFF_MAX_MS;
+        esp_start_failures++;
+        esp_start_not_before = xTaskGetTickCount() + pdMS_TO_TICKS(backoff_ms);
+        print_logf(LOG_ERROR, "SDR", "Starting the USB stream at %u Hz, %u S/s failed: %s (attempt %u, next in %u s)",
+                freq, rate, esp_rtl_sdr_err_to_name(err), esp_start_failures, backoff_ms / 1000u);
+        dev->esp_streaming = 0; // the reader gives up instead of spinning on NOT_STREAMING
+        return -1;
+    }
+    esp_start_failures = 0;
+    dev->esp_streaming = 1;
+    esp_sdr_apply_gain(dev);
+    // Like gain, these need the claimed interface
+    if (dev->esp_biastee >= 0)
+        esp_rtl_sdr_set_bias_tee(dev->esp_dev, dev->esp_biastee != 0);
+    if (dev->esp_digital_agc >= 0)
+        esp_rtl_sdr_set_rtl_agc(dev->esp_dev, dev->esp_digital_agc != 0);
+    return 0;
+}
+
+// Throw away what the driver has buffered: a hot retune or rate change does not clear its pull ring, so
+// whatever is in it was captured with the old settings
+static void esp_sdr_discard_buffered(sdr_dev_t *dev, uint8_t *scratch, size_t len)
+{
+    size_t got;
+    int rounds = 0;
+    do {
+        got = 0;
+        if (esp_rtl_sdr_read(dev->esp_dev, scratch, len, 0, &got) != ESP_OK)
+            break; // empty (timeout) or not streaming
+    } while (got == len && ++rounds < 64); // a full read: there may be more
+}
+
+static int esp_sdr_read_loop(sdr_dev_t *dev, sdr_event_cb_t cb, void *ctx, uint32_t buf_num, uint32_t buf_len)
+{
+    size_t buffer_size = (size_t)buf_num * buf_len;
+    if (dev->buffer_size != buffer_size) {
+        free(dev->buffer);
+        dev->buffer = malloc(buffer_size);
+        if (!dev->buffer) {
+            WARN_MALLOC("esp_sdr_read_loop()");
+            return -1;
+        }
+        dev->buffer_size = buffer_size;
+        dev->buffer_pos = 0;
+    }
+
+    if (!dev->esp_streaming) {
+        if (esp_start_failures && (int32_t)(xTaskGetTickCount() - esp_start_not_before) < 0)
+            return -1; // still backing off; the stall watchdog calls again
+        if (esp_sdr_start_stream(dev) < 0)
+            return -1;
+    }
+
+    // Every block is labelled with the settings it was captured with. A retune or rate change (main task)
+    // bumps esp_tune_gen once it has taken effect; samples captured before it can still be in the driver's
+    // ring, and a hop retunes while the previous block is being decoded, so the next block starts by
+    // dropping them, and a block that a change landed in the middle of is dropped whole. That costs about
+    // one block per hop, which used to be decoded at the new band's rate with its decoders anyway.
+    uint32_t seen_disconnects = esp_disconnects; // one after this: NOT_STREAMING means unplugged, give up
+    uint32_t seen_errors = esp_errors;           // one after this: the driver reported a dead or mistuned stream
+    uint32_t seen_gen;
+#ifdef THREADS
+    pthread_mutex_lock(&dev->lock);
+#endif
+    seen_gen = dev->esp_tune_gen;
+#ifdef THREADS
+    pthread_mutex_unlock(&dev->lock);
+#endif
+
+    dev->running = 1;
+    do {
+        if (dev->buffer_pos + buf_len > buffer_size)
+            dev->buffer_pos = 0;
+        uint8_t *buffer = &dev->buffer[dev->buffer_pos];
+        dev->buffer_pos += buf_len;
+
+        uint32_t gen;
+#ifdef THREADS
+        pthread_mutex_lock(&dev->lock);
+#endif
+        gen = dev->esp_tune_gen;
+#ifdef THREADS
+        pthread_mutex_unlock(&dev->lock);
+#endif
+        if (gen != seen_gen) {
+            esp_sdr_discard_buffered(dev, buffer, buf_len);
+            seen_gen = gen;
+        }
+
+        size_t n_read = 0;
+        int exit_acquire = 0;
+        int not_streaming_ms = 0;
+        while (n_read < buf_len) {
+#ifdef THREADS
+            pthread_mutex_lock(&dev->lock);
+            exit_acquire = dev->exit_acquire;
+            pthread_mutex_unlock(&dev->lock);
+#endif
+            if (exit_acquire || !dev->running)
+                break;
+            if (esp_errors != seen_errors) {
+                // Stop delivering; rtl_433's stall watchdog restarts the input with a full start at the
+                // requested frequency and rate.
+                print_log(LOG_WARNING, "SDR", "USB SDR reported an error; restarting the input");
+                dev->esp_streaming = 0;
+                dev->running = 0;
+                break;
+            }
+            size_t got = 0;
+            esp_err_t err = esp_rtl_sdr_read(dev->esp_dev, &buffer[n_read], buf_len - n_read,
+                    ESP_SDR_READ_TIMEOUT_MS, &got);
+            if (err == ESP_OK) {
+                n_read += got;
+                not_streaming_ms = 0;
+            }
+            else if (err == ESP_RTL_SDR_ERR_NOT_STREAMING && dev->esp_streaming && esp_disconnects == seen_disconnects
+                    && not_streaming_ms < ESP_SDR_NOT_STREAMING_MAX_MS) {
+                vTaskDelay(pdMS_TO_TICKS(10)); // a rate change is restarting the stream
+                not_streaming_ms += 10;
+            }
+            else if (err != ESP_RTL_SDR_ERR_TIMEOUT && err != ESP_ERR_TIMEOUT) {
+                // Unplugged or faulted. Stop delivering; rtl_433's stall watchdog restarts the input.
+                print_logf(LOG_WARNING, "SDR", "USB read failed: %s", esp_rtl_sdr_err_to_name(err));
+                dev->esp_streaming = 0; // (the disconnect callback used to clear this, racing sdr_close)
+                dev->running = 0;
+                break;
+            }
+            // on timeout just go round: no samples yet, check exit_acquire again
+        }
+        if (exit_acquire)
+            break;
+
+#ifdef THREADS
+        pthread_mutex_lock(&dev->lock);
+#endif
+        uint32_t sample_rate      = dev->sample_rate;
+        uint32_t center_frequency = dev->center_frequency;
+        gen                       = dev->esp_tune_gen;
+#ifdef THREADS
+        pthread_mutex_unlock(&dev->lock);
+#endif
+        if (gen != seen_gen)
+            continue; // the settings changed while this block filled: part of it is the old band
+        sdr_event_t ev = {
+                .ev               = SDR_EV_DATA,
+                .sample_rate      = sample_rate,
+                .center_frequency = center_frequency,
+                .buf              = buffer,
+                .len              = n_read,
+        };
+        if (n_read > 0)
+            cb(&ev, ctx);
+        // our own stack high-water mark, for the health sensor (see rtl433_port.h)
+        {
+            static TickType_t last_hwm = 0;
+            TickType_t now_ticks = xTaskGetTickCount();
+            if (now_ticks - last_hwm > pdMS_TO_TICKS(1000)) {
+                last_hwm = now_ticks;
+                rtl433_port_acquire_stack_free = (unsigned)uxTaskGetStackHighWaterMark(NULL);
+            }
+        }
+    } while (dev->running);
+
+    return 0;
+}
+
+void sdr_abort(sdr_dev_t *dev)
+{
+    if (!dev)
+        return;
+#ifdef THREADS
+    pthread_mutex_lock(&dev->lock);
+    dev->exit_acquire = 1;
+#endif
+    dev->running = 0;
+#ifdef THREADS
+    pthread_mutex_unlock(&dev->lock);
+#endif
+    if (dev->esp_dev) {
+        pthread_mutex_lock(&esp_active_lock);
+        if (esp_active == dev->esp_dev)
+            esp_active = NULL;
+        pthread_mutex_unlock(&esp_active_lock);
+        esp_rtl_sdr_stop(dev->esp_dev, 0); // a pending read returns NOT_STREAMING and the reader ends
+        dev->esp_streaming = 0;
+    }
+}
