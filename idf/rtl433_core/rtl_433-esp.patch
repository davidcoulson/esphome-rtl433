+// Counts the driver's disconnect events. The callback runs on the driver's USB task, which must not touch an
+// sdr_dev_t: the main task can close (free) it at any moment. The read loop compares this instead.
+static volatile uint32_t esp_disconnects = 0;
+
+static void esp_sdr_event_cb(esp_rtl_sdr_event_t event, const void *payload, void *ctx)
+{
+    UNUSED(ctx);
+    switch (event) {
+    case ESP_RTL_SDR_EVT_ENUMERATED: {
+        esp_rtl_sdr_device_info_t const *info = payload;
+        if (info)
+            print_logf(LOG_NOTICE, "SDR", "USB SDR attached: %s %s, SN: %s (%s speed)",
+                    info->manufacturer, info->product, info->serial, info->high_speed ? "high" : "full");
+        break;
+    }
+    case ESP_RTL_SDR_EVT_DISCONNECTED:
+        esp_disconnects++; // first: the log below may block
+        print_log(LOG_ERROR, "SDR", "USB SDR disconnected");
+        break;
+    case ESP_RTL_SDR_EVT_ERROR: {
+        esp_rtl_sdr_error_info_t const *err = payload;
+        if (err)
+            print_logf(LOG_WARNING, "SDR", "esp_rtl_sdr: %s %s", esp_rtl_sdr_err_to_name(err->code), err->message);
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+static int esp_opened_before = 0; // only the first open (start-up) waits for the dongle
+static int esp_absent_logged = 0; // "no dongle" is logged once per absence, not on every retry
+
+static int esp_sdr_open(sdr_dev_t **out_dev, char const *dev_query, int verbose)
+{
+    UNUSED(verbose);
+    int may_wait = !esp_opened_before;
+    esp_opened_before = 1;
+    if (esp_handle == NULL) {
+        esp_rtl_sdr_config_t config;
+        esp_rtl_sdr_config_default(&config);
+        if (rtl433_port_usb_ring_bytes)
+            config.pull_ring_bytes = rtl433_port_usb_ring_bytes;
+        if (rtl433_port_usb_task_priority)
+            config.usb_task_priority = rtl433_port_usb_task_priority;
+        config.usb_task_core_id = rtl433_port_usb_task_core;
+        config.event_cb = esp_sdr_event_cb;
+        config.event_ctx = NULL; // set per open below: the dev comes and goes, the handle doesn't
+        config.delivery_mode = ESP_RTL_SDR_DELIVERY_READ; // rtl_433 pulls, like a socket
+        esp_err_t err = esp_rtl_sdr_install(&config, &esp_handle);
+        if (err == ESP_RTL_SDR_ERR_USB_SAFE_MODE) {
+            // The driver's crash guard: the USB stack panicked during enumeration on several boots in a
+            // row, so it stays off for this boot rather than boot-looping. Only a real latch reaches here.
+            print_log(LOG_ERROR, __func__, "USB host disabled for this boot after repeated USB crashes; power-cycle to retry");
+            esp_handle = NULL;
+            return -1;
+        }
+        if (err != ESP_OK) {
+            print_logf(LOG_ERROR, __func__, "esp_rtl_sdr_install failed: %s", esp_rtl_sdr_err_to_name(err));
+            esp_handle = NULL;
+            return -1;
+        }
+    }
+
+    // The dongle enumerates asynchronously after the host library starts, so the first open (start-up,
+    // right after the install, before the event loop runs) waits for it. Every later open is a retry from
+    // timer_handler() on the event loop, which comes back every 1.5 s: it only looks, because waiting
+    // there stalls HTTP and WebSocket for as long as the dongle is missing.
+    esp_rtl_sdr_device_info_t info = {0};
+    int waited_ms = 0;
+    while (esp_rtl_sdr_get_device_info(esp_handle, &info) != ESP_OK || !info.present) {
+        if (!may_wait || waited_ms >= ESP_SDR_ATTACH_WAIT_MS) {
+            if (!esp_absent_logged)
+                print_log(LOG_ERROR, __func__, "No supported RTL-SDR dongle on the USB host port");
+            esp_absent_logged = 1;
+            return -1;
+        }
+        vTaskDelay(pdMS_TO_TICKS(100));
+        waited_ms += 100;
+    }
+    esp_absent_logged = 0;
+
+    // Allocated only once the dongle is there: nothing to undo on the failure paths above
+    sdr_dev_t *dev = calloc(1, sizeof(sdr_dev_t));
+    if (!dev) {
+        WARN_CALLOC("esp_sdr_open()");
+        return -1;
+    }
+#ifdef THREADS
+    pthread_mutex_init(&dev->lock, NULL);
+#endif
+    dev->esp_gain = -1;
+    dev->esp_biastee = -1;
+    dev->esp_digital_agc = -1;
+    dev->esp_dev = esp_handle;
+    esp_err_t err;
+
+    // "esp:SERIAL" picks one dongle when several share a hub
+    char const *serial = arg_param(dev_query);
+    if (serial && *serial) {
+        err = esp_rtl_sdr_select_device_serial(dev->esp_dev, serial);
+        if (err != ESP_OK)
+            print_logf(LOG_WARNING, __func__, "No dongle with serial %s (%s); using the first one",
+                    serial, esp_rtl_sdr_err_to_name(err));
+        esp_rtl_sdr_get_device_info(dev->esp_dev, &info);
+    }
+
+    print_logf(LOG_CRITICAL, "SDR", "Using USB device: %s, %s, SN: %s", info.manufacturer, info.product, info.serial);
+    dev->sample_size = sizeof(uint8_t) * 2; // CU8
+    dev->sample_signed = 0;
+
+    size_t info_len = 41 + strlen(info.manufacturer) + strlen(info.product) + strlen(info.serial);
+    dev->dev_info = malloc(info_len);
+    if (dev->dev_info)
+        snprintf(dev->dev_info, info_len, "{\"vendor\":\"%s\", \"product\":\"%s\", \"serial\":\"%s\"}",
+                info.manufacturer, info.product, info.serial);
+
+    pthread_mutex_lock(&esp_active_lock);
+    esp_active = dev->esp_dev;
+    pthread_mutex_unlock(&esp_active_lock);
+
+    *out_dev = dev;
+    return 0;
+}
